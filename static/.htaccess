# Apache config for the Docusaurus static build (copied into build/ as-is).

# Docusaurus' own "page not found" page
ErrorDocument 404 /404.html

# Docusaurus generates explicit index.html files; avoid content negotiation surprises
Options -MultiViews

<IfModule mod_headers.c>
    # Hashed bundles never change: cache for a year
    <FilesMatch "\.[0-9a-f]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # HTML must always be revalidated so new posts appear immediately
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
